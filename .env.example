# Copy to .env and fill in.
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority
PORT=5000
# Stripe test key (dashboard.stripe.com -> Developers -> API keys)
STRIPE_SECRET=sk_test_xxx
# Firebase service account JSON, base64/inline (Firebase console -> Project settings -> Service accounts)
FIREBASE_SERVICE_ACCOUNT={}
